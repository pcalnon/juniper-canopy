# =============================================================================
# juniper-canopy — Production Environment
# Connects to real CasCor service with production-appropriate defaults.
# Usage: cp .env.prod .env  (then customize secrets)
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────
JUNIPER_CANOPY_SERVER__HOST=0.0.0.0
JUNIPER_CANOPY_SERVER__PORT=8050

# ── Logging ───────────────────────────────────────────────────────────
JUNIPER_CANOPY_LOG_LEVEL=INFO

# ── Backend ───────────────────────────────────────────────────────────
JUNIPER_CANOPY_JUNIPER_DATA_URL=http://juniper-data:8100
JUNIPER_CANOPY_CASCOR_SERVICE_URL=http://juniper-cascor:8200

# ── Security ─────────────────────────────────────────────────────────
JUNIPER_CANOPY_RATE_LIMIT_ENABLED=true
JUNIPER_CANOPY_RATE_LIMIT_REQUESTS_PER_MINUTE=60
