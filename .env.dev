# =============================================================================
# juniper-canopy — Development Environment
# Enables demo mode with verbose logging for local development.
# Usage: cp .env.dev .env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────
JUNIPER_CANOPY_SERVER__HOST=127.0.0.1
JUNIPER_CANOPY_SERVER__PORT=8050
JUNIPER_CANOPY_SERVER__DEBUG=true

# ── Logging ───────────────────────────────────────────────────────────
JUNIPER_CANOPY_LOG_LEVEL=DEBUG

# ── Backend ───────────────────────────────────────────────────────────
JUNIPER_CANOPY_JUNIPER_DATA_URL=http://localhost:8100
JUNIPER_CANOPY_DEMO_MODE=true

# ── Security (relaxed for local dev) ─────────────────────────────────
JUNIPER_CANOPY_RATE_LIMIT_ENABLED=false
