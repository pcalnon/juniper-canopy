# =============================================================================
# JuniperCanopy — Docker build context exclusions
# =============================================================================

# Version control
.git/
.gitignore

# CI/CD and tooling config
.github/
.pre-commit-config.yaml
.bandit.yml
.codecov.yml
.coveragerc
.markdownlint.json
.markdownlint.yaml
.yamllint.yaml
.trunk/
.mypy_cache/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*.swn

# Documentation and notes
notes/
docs/
images/
AGENTS.md
CLAUDE.md
CHANGELOG.md
LICENSE
markdown.css

# Tests (not needed in production image)
src/tests/
conftest.py

# Development artifacts
__pycache__/
**/__pycache__/
*.py[cod]
# ``*.egg-info/`` alone only matches the context root. The ``**/``-prefixed
# forms are required to exclude *nested* metadata dirs such as
# ``src/juniper_canopy.egg-info`` — a stale local build artifact that, when
# COPYed into the image by ``COPY src/ ./src/``, lands on PYTHONPATH (/app/src)
# ahead of site-packages and shadows the installed package version. That was
# the bug behind ``/v1/health`` reporting an old version (0.4.0) while
# ``pyproject.toml`` was 0.5.0 — surfaced by the build-provenance `make doctor`
# work (juniper-ml notes/BUILD_PROVENANCE_DESIGN_2026-06-14.md).
*.egg-info/
**/*.egg-info/
**/*.dist-info/
build/
dist/
data/
logs/
reports/
*.prof
*.log
*.out

# Coverage
.coverage
**/.coverage
coverage.xml
coverage.json

# Conda (not used in Docker — pip only)
conda_environment.yaml
conda_environment_ci.yaml

# Conf files not needed in image
conf/*.conf
conf/*_functions.conf
conf/__pycache__/
conf/backups/
conf/conda_environment*.yaml
conf/requirements*.txt
conf/setup-miniconda-patched-conda_environment.yaml

# Sensitive / local-only
.env
.mcp.json
.serena/
__RESUME_CLAUDE_SESSION__
.claude/

# OS artifacts
.DS_Store
Thumbs.db

# Archives and binaries
*.gz
*.tgz
*.tar
*.zip
*.whl
*.deb
*.rpm

# Demo launcher script (not needed in container)
demo
